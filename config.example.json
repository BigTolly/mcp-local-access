{
  "rootDir": "C:/usr/mcp/local-access",
  "host": "0.0.0.0",
  "port": 8000,
  "readOnly": false,
  "jsonResponse": false,
  "rulesFile": "Rules.md",
  "logDir": "logs",
  "audit": true,
  "maxCommandTimeout": 600,

  "dialog": {
    "width": 500,
    "height": 300,
    "sound": true,
    "autoPrompt": true,
    "waitTimeoutSeconds": 600
  },

  "browser": {
    "enabled": true,
    "host": "localhost",
    "port": 9009,
    "timeoutSeconds": 30,
    "allowFileUrls": false,
    "chromePath": "",
    "userDataDir": "",
    "profileDirectory": "",
    "launchArgs": [],
    "launchTimeoutSeconds": 30,
    "closeTimeoutSeconds": 10
  },

  "permissions": {
    "defaultMode": "allow",
    "allow": [
      "List(**)",
      "Read(**)",
      "Edit(**)",
      "Create(**)",
      "Delete(**)",
      "Run(npm run dev)",
      "Run(npm run build)",
      "Run(npm install)",
      "Run(git status)",
      "Run(git diff*)",
      "Run(python *)",
      "Run(pytest*)"
    ],
    "deny": [
      "*(**/.env)",
      "*(**/.env.*)",
      "*(**/config.json)",
      "*(**/secrets/**)",
      "*(**/*.pem)",
      "*(**/*.key)",
      "Edit(**/.git/**)",
      "Create(**/.git/**)",
      "Delete(**/.git/**)"
    ]
  }
}
