{
  "manifest_version": 3,
  "name": "Browser Control",
  "short_name": "Browser Control",
  "version": "1.0.0",
  "description": "Browser automation bridge for the Local Access MCP server: page tools, console, network and the DevTools protocol.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Browser Control",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/neutral-16.png",
      "32": "icons/neutral-32.png"
    }
  },
  "icons": {
    "16": "icons/neutral-16.png",
    "32": "icons/neutral-32.png",
    "48": "icons/neutral-48.png",
    "128": "icons/neutral-128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "debugger",
    "offscreen",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+J" }
    }
  }
}
